# 运行时软件源（apk）
#
# LibWrt 25.12-nss 默认 CONFIG_USE_APK=y，包管理是 apk，不是 opkg。
# 固件里内置两把公钥：/etc/apk/keys/openwrt-25.12.pem、immortalwrt-25.12.pem，
# 所以下面这两个源都能验签通过。
#
# 实测（2026-11-03，aarch64_cortex-a53）：
#   immortalwrt 25.12-SNAPSHOT  base 761 + packages 4753 + luci 3719
#                               + routing 56 + telephony 868 + video 0 = 10,157
#   openwrt releases/packages-25.12                          = 8,596（含 video 60）
#   openwrt snapshots                                        = 9,798
#   dl.openwrt.ai 只有 .ipk，无 .apk —— apk 固件用不了
#
# 结论：immortalwrt 25.12-SNAPSHOT 最全，且与固件同源（LibWrt 的默认 VERSION_REPO）。
# video 类 immortalwrt 不发布这个架构，开 CONFIG_FEED_video 会让 apk update 对这条 feed 404。
#
# 用法：cat ax1800/config/repos.config >> .config
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/25.12-SNAPSHOT"
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_PER_FEED_REPO=y

CONFIG_FEED_packages=y
CONFIG_FEED_luci=y
CONFIG_FEED_routing=y
CONFIG_FEED_telephony=y
# CONFIG_FEED_video is not set

# 这两个是 CI 现编的 feed（NSS 驱动、sqm-scripts-nss），从来没有在线镜像，
# scripts/feeds 里本来就默认关；显式写一遍，避免哪天上游改了默认又把它们放进运行时源。
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set

# iStore 来自官方 linkease/istore 源码 feed，没有对应的在线 apk 源
# CONFIG_FEED_istore is not set
