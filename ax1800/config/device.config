# 设备与基础配置（叠加在 make defconfig 之上）
# 用法：cat ax1800/config/device.config >> .config

# ---- 目标与机型 ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set

# ---- 版本串 ----
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_MANUFACTURER="JDCloud"
CONFIG_VERSION_PRODUCT="AX1800 Pro"

# ---- 中文默认设置 ----
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 主题：jerrykuku 的 argon 3.1.2（构建时 clone 进 package/，见 workflow）----
CONFIG_PACKAGE_luci-theme-argon=y

# ---- 内核：BBR 拥塞控制 ----
CONFIG_PACKAGE_kmod-tcp-bbr=y
