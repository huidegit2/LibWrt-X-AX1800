# dae 需要的内核能力（只有 12M 分区装得下，6M 会溢出）
#
# 现在只开内核侧；dae 本体和 luci-app-dae 以后单独装
# （BTF/XDP 打开后，装包时 dae 的 @HAS_BPF_TOOLCHAIN 依赖才成立）。
#
# 用法：cat ax1800/config/kernel-dae.config >> .config  然后 make defconfig
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# DEBUG_INFO_REDUCED 默认 y，而 BTF depends on !REDUCED —— 不显式关掉，BTF 永远选不上
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
